    for x in range(0, WIDTH, 100):
        pygame.draw.rect(
            screen, LIGHT_GREEN,
            (x + 100, 50, 100, HEIGHT - 100)
        )



    pygame.draw.ellipse(
        screen, WHITE,
        (35, 115, WIDTH - 70, 480), 3
    )


    pygame.draw.rect(
        screen, PITCH,
        (130, 260, 700, 155),
        border_radius=8
    )



    pygame.draw.line(
        screen, WHITE,
        (790, 270), (790, 405), 3
    )


    pygame.draw.line(
        screen, CREAM,
        (160, 337), (790, 337), 1
    )




def draw_scoreboard():
    pygame.draw.rect(screen, BLACK, (0, 0, WIDTH, 100))


    text("CRICKET CAREER", 20, 8, SMALL, GOLD)
    text(f"{runs}/{wickets}", 20, 28, BIG)


    overs = f"{legal_balls // 6}.{legal_balls % 6}"
    text(f"Overs: {overs}/{MAX_OVERS}", 235, 43)
    text(f"Extras: {extras}", 450, 43)
    text(f"Mode: {mode.title()}", 720, 43, FONT, GOLD)


    if mode == "batting":
        text(
            "1 Defensive    2 Normal    3 Attack    SPACE: shot",
            20, 75, SMALL
        )
    else:
        text(
            "UP/DOWN: move keeper   SPACE: dive/catch",
            20, 75, SMALL
        )




def draw_match():
    draw_ground()
    draw_scoreboard()



    draw_player(BOWLER_X, 345, RED)
    text("BOWLER", BOWLER_X - 35, 380, SMALL)


    draw_player(
        BATTER_X, BATTER_Y, BLUE, batting=True
    )
    draw_stumps(STUMPS_X, BATTER_Y)
    text("BATTER", BATTER_X - 35, 395, SMALL)



    draw_player(
        KEEPER_X, keeper_y, RED,
        keeping=True, diving=keeper_dive_y
    )
    text("KEEPER", KEEPER_X - 38, 395, SMALL)


    if ball_active:
        pygame.draw.circle(
            screen, RED,
            (int(ball_x), int(ball_y)), 8
        )
        pygame.draw.circle(
            screen, WHITE,
            (int(ball_x - 2), int(ball_y -2)), 2
        )



    if mode == "batting" and ball_active:
        pygame.draw.line(
            screen, GOLD,
            (BATTER_X - 50, 420),
            (BATTER_X + 15, 420), 4
        )


    text(
        message, WIDTH // 2, 520,
        FONT, GOLD, center=True
    )



