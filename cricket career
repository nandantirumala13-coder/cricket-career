WHITE = (255, 255, 255)
BLACK = (25, 30, 28)
GREEN = (35, 125, 55)
DARK_GREEN = (20, 75, 38)
LIGHT_GREEN = (60, 145, 65)
PITCH = (190, 155, 105)
CREAM = (245, 225, 180)
BLUE = (40, 100, 220)
RED = (205, 55, 55)
GOLD = (255, 205, 65)
SKIN = (195, 145, 105)



BATTER_X = 690
BATTER_Y = 345
KEEPER_X = 835
STUMPS_X = 720
BOWLER_X = 190
BALL_SPEED = 390



state = "menu"
mode = "batting"


runs = 0
wickets = 0
legal_balls = 0
extras = 0
boundaries = 0
catches = 0
stumpings = 0
missed_balls = 0


ball_x = BOWLER_X
ball_y = 320
ball_target_y = 320
ball_active = False
delivery_type = "normal"
delivery_start_x = BOWLER_X 


keeper_y = 340
keeper_diving = 0
keeper_dive_y = 0


shot_type = 2
shot_requested = False
delivery_resolved = False
message = ""
message_time = 0
last_delivery_time = 0





def text(value, x, y, font=FONT, colour=WHITE, center=False):
    image = font.render(str (value), True, colour)
    rect = image.get_rect()


    if center:
        rect.center = (x, y)
    else:
        rect.topleft = (x, y)


    screen.blit(image, rect)


def draw_stumps(x, y):
    for offset in (-9, 0, 9):
        pygame.draw.rect(
            screen, CREAM,
            (int(x + offset), int(y - 28), 4, 30)
        )

    pygame.draw.rect(
        screen, CREAM,
        (int(x - 12), int(y - 30), 26, 3)
    )


def draw_player(x, y, colour, batting=False,
                keeping=False, diving=0):
    """Draw a simple player with moving legs."""


    tick = pygame.time.get_ticks()
    leg_move = math.sin(tick * 0.012) * 4


    pygame.draw.circle(
        screen, SKIN, (int(x), int(y - 48)), 12
    )



    pygame.draw.arc(
        screen, colour,
        (int(x - 13), int(y - 62), 26, 22),
        0, math.pi, 4
    )



    pygame.draw.rect(
        screen, colour,
        (int(x - 13), int(y - 36), 26, 35),
        border_radius=5
    )



    pygame.draw.line(
        screen, WHITE,
        (x - 6, y - 2),
        (x - 12 + leg_move, y + 22), 6
    )
    pygame.draw.line(
        screen, WHITE,
        (x + 6, y - 2),
        (x + 12 - leg_move, y + 22), 6
    )


    if batting:

        pygame.draw.line(
            screen, SKIN,
            (x - 10, y - 28),
            (x - 23, y - 8), 6
        )
        pygame.draw.line(
            screen, SKIN,
            (x + 10, y - 28),
            (x - 17, y - 10), 6
        )
        pygame.draw.line(
            screen, SKIN,
            (x -20, y - 10),
            (x - 34, y + 35), 9
        )


    elif keeping:

        glove_y = y - 15 + diving


        pygame.draw.line(
            screen, SKIN,
            (x - 10, y - 28),
            (x - 18, glove_y), 6
        )
        pygame.draw.line(
            screen, SKIN,
            (x + 10, y - 28),
            (x + 18, glove_y), 6
        )


        pygame.draw.circle(
            screen, GOLD, (int(x - 18), int(glove_y)), 9
        )
        pygame.draw.circle(
            screen, GOLD, (int(x + 18), int(glove_y)), 9
        )

    else:

        pygame.draw.line(
            screen, SKIN,
            (x - 10, y - 28),
            (x - 22, y - 5), 6
        )
        pygame.draw.line(
            screen, SKIN,
            (x + 10, y - 28),
            (x + 22, y - 7), 6
        )




def draw_ground():
