def start_game(selected_mode):
    global state, mode, runs, wickets, legal_balls
    global extras, boundaries, catches, stumpings
    global missed_balls, keeper_y


    state = "playing"
    mode = selected_mode


    runs = 0
    wickets = 0
    legal_balls = 0
    extras = 0
    boundaries = 0
    catches = 0
    stumpings = 0
    missed_balls = 0


    keeper_y = 340
    new_delivery()




def new_delivery():
    global ball_x, ball_y, ball_target_y
    global ball_active, delivery_type
    global shot_requested, delivery_resolved
    global message, keeper_diving, keeper_dive_y


    ball_x = BOWLER_X + 20
    ball_y = random.choice([300, 320, 350]) 
    ball_target_y = random.choice([285, 320, 360])


    delivery_type = random.choices(
        ["normal", "wide", "no_ball", "bouncer"],
        weights=[83, 7, 4, 6]
    )[0]


    shot_requested = False
    delivery_resolved = False
    ball_active = True
    keeper_diving = 0
    keeper_dive_y = 0
    message = ""




def finish_delivery(result, legal=True, score=0, wicket=False):
    global runs, wickets, legal_balls, extras
    global boundaries, ball_active, message
    global message_time, state


    runs += score


    if score in (4, 6):
        boundaries += 1


    if wicket:
        wickets+= 1


    if legal:
        legal_balls += 1


    ball_active = False
    message = result
    message_time = pygame.time.get_ticks()


    if wickets >= 10 or legal_balls >= MAX_OVERS * 6:
        state = "summary"




def resolve_batting():
    global delivery_resolved, extras


    if delivery_resolved:
        return


    delivery_resolved = True



    if delivery_type == "wide":
        extras += 1
        finish_delivery("WIDE! +1 EXTRA", legal=False, score=1)
        return


    if delivery_type == "no_ball":
        extras += 1
        finish_delivery("NO BALL! +1 EXTRA", legal=False, score=1)
        return



    distance = abs(ball_x - BATTER_X)
    timing = max(0, 100 - distance * 1.5)
    timing += random.randint(-10, 10)


    if not shot_requested:
        if random.random() < 0.12:
            finish_delivery("BOWLED! YOU MISSED IT.", wicket=True)
        else:
            finish_delivery("DOT BALL.")
        return



    if shot_type == 3:
        if timing < 35:
            if random.random() < 0.35:
                finish_delivery("CAUGHT! MISTIMED SHOT.", wicket=True)
            else:
                finish_delivery("BEATEN! DOT BALL.")
            return


        outcome = random.choices(
            [0, 1, 2, 3, 4, 5, 6, "wicket"],
            weights=[10, 12, 18, 5, 25, 5, 15, 10]
        )[0]


    else:

        if timing < 20:
            if random.random() < 0.20:
                finish_delivery("BOWLED!", wicket=True)
            else:
                finish_delivery("BEATEN. DOT BALL")
            return


        outcome = random.choices(
            [0, 1, 2, 3, 4, 5, 6, "wicket"],
            weights=[20, 28, 20, 4, 17, 5, 6, 0]
        )[0]


    if outcome == "wicket":
        finish_delivery("CAUGHT! YOU ARE OUT.", wicket=True)
    else:
        finish_delivery(f"{outcome} RUN(s)!", score=outcome)




def resolve_keeping():
    global delivery_resolved, catches, stumpings
    global missed_balls, extras


    if delivery_resolved:
        return


    delivery_resolved = True


    distance = abs(ball_y - keeper_y)
    dived = keeper_diving > 0



    if distance < 25 or (dived and distance < 65):
        if random.random() < 0.18:
            catches += 1
            finish_delivery("CAUGHT BEHIND! WICKET!", wicket=True)
        elif random.random() < 0.08:
            stumpings += 1
            finish_delivery("STUMPED! WICKET.", wicket = True)
        else:
            finish_delivery("CLEAN COLLECTION. DOT BALL.")
    else:
        missed_balls += 1
        extras += 1 
        finish_delivery("MISSED! +1 BYE.", score=1)





running = True


while running:
    dt = clock.tick(FPS) / 1000
    now = pygame.time.get_ticks()


    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False


        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                running = False


            if state == "menu":
                if event.key == pygame.K_1:
                    start_game("batting")
                elif event.key == pygame.K_2:
                    start_game("keeping")


            elif state == "playing":
                if mode == "batting":
                    if event.key == pygame.K_1:
                        shot_type = 1
                    elif event.key == pygame.K_2:
                        shot_type = 2
                    elif event.key == pygame.K_3:
                        shot_type = 3
                    elif event.key == pygame.K_SPACE and ball_active:
                        shot_requested = True


                else:
                    if event.key == pygame.K_UP:
                        keeper_y -= 25
                    elif event.key == pygame.K_DOWN:
                        keeper_y += 25
                    elif event.key == pygame.K_SPACE and ball_active:
                        keeper_diving = 15

                        keeper_dive_y = (
                            -18 if ball_y < keeper_y else 18
                        )
                        keeper_y += keeper_dive_y


            elif state == "summary":
                if event.key == pygame.K_r:
                    start_game(mode)
                elif event.key == pygame.K_m:
                    state = "menu"


    if state == "playing":
        keeper_y = max(275, min(405, keeper_y))


        if keeper_diving > 0:
            keeper_diving -= 1


        if ball_active:
            ball_x += BALL_SPEED * dt    



            ball_y += (
                ball_target_y - ball_y
            ) * min(1, dt * 2.5)


            if mode == "batting":

                if ball_x >= BATTER_X:
                    resolve_batting()


            else:

                if ball_x >= KEEPER_X:
                    resolve_keeping()



            if ball_active and ball_x > WIDTH:
                if mode == "keeping":
                    missed_balls += 1
                    extras += 1
                    finish_delivery("MISSED! +1 BYE.", score=1)
                else:
                    finish_delivery("DOT BALL.")


        elif state == "playing":
            if now - message_time > 1000:
                new_delivery()



    if state == "menu":
        draw_menu()
    elif state == "playing":
        draw_match()
    elif state == "summary":
        draw_summary()


    pygame.display.flip()


pygame.quit()
sys.exit()



                


        
            


            
        












            
        




    
